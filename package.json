{
  "name": "3d-html-car-racer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first Three.js endless car racer, playable in the browser and installable as a PWA.",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node build/check-bundle-size.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "assets": "node tools/render-assets.mjs",
    "model:car": "node tools/export-car-glb.mjs",
    "model:check": "node tools/check-car.mjs",
    "assets:glb": "node tools/export-glb.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
